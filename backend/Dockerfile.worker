FROM gilleslamiral/imapsync:latest

USER root

RUN sed -i \
      -e '/deb.debian.org\/debian-security/d' \
      -e 's|deb.debian.org/debian|archive.debian.org/debian|' \
      /etc/apt/sources.list \
    && apt-get update -o Acquire::Check-Valid-Until=false && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

COPY app ./app

RUN mkdir -p /data /logs

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV PATH="/opt/venv/bin:$PATH"
